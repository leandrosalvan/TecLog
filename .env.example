# Copie para .env e ajuste.
# Sem DATABASE_URL o app usa SQLite (teclog.db).
# Com DATABASE_URL usa Postgres (local ou Neon/produção).

DATABASE_URL=postgresql://strapi:strapi@127.0.0.1:5432/teclog
SECRET_KEY=trocar-em-producao
TZ=America/Sao_Paulo

# Opcional (cria admin na 1ª subida se não existir):
# ADMIN_EMAIL=admin@teclog.com
# ADMIN_SENHA=
